<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/contrast_background_color">

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/playlist_title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/video_item_search_padding"
        android:paddingTop="@dimen/video_item_search_padding"
        android:paddingBottom="6dp"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textSize="@dimen/playlist_detail_title_text_size"
        tools:text="Mix musics #23 title Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc tristique vitae sem vitae blanditLorem ipsumLorem ipsumLorem ipsumLorem ipsumLorem ipsumLorem ipsumLorem ipsum" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/playlist_stream_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/playlist_title_view"
        android:layout_alignParentLeft="true"
        android:ellipsize="end"
        android:gravity="right|center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/video_item_search_padding"
        android:textSize="@dimen/playlist_detail_subtext_size"
        tools:ignore="RtlHardcoded"
        tools:text="234 videos" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/playlist_watched_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/playlist_stream_count"
        android:paddingHorizontal="@dimen/video_item_search_padding"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:textSize="@dimen/playlist_detail_subtext_size"
        tools:text="2 of 5 watched" />

    <ProgressBar
        android:id="@+id/playlist_watched_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/playlist_watched_count"
        android:layout_marginHorizontal="@dimen/video_item_search_padding"
        android:layout_marginBottom="4dp"
        android:progressDrawable="@drawable/progress_watched_horizontal"
        android:max="100" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/playlist_completed_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/playlist_watched_progress"
        android:paddingHorizontal="@dimen/video_item_search_padding"
        android:paddingBottom="4dp"
        android:textColor="#4CAF50"
        android:textStyle="bold"
        android:text="@string/playlist_completed_text"
        android:visibility="gone" />

    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/playlist_control"
        layout="@layout/playlist_control"
        android:layout_below="@id/playlist_completed_badge" />

</RelativeLayout>
