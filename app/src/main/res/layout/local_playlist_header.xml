<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/contrast_background_color">

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/playlist_title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/video_item_search_padding"
        android:paddingTop="@dimen/video_item_search_padding"
        android:paddingBottom="6dp"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textSize="@dimen/playlist_detail_title_text_size"
        tools:text="Mix musics #23 title Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc tristique vitae sem vitae blanditLorem ipsumLorem ipsumLorem ipsumLorem ipsumLorem ipsumLorem ipsumLorem ipsum" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/playlist_stream_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/playlist_title_view"
        android:layout_alignParentLeft="true"
        android:ellipsize="end"
        android:gravity="right|center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/video_item_search_padding"
        android:textSize="@dimen/playlist_detail_subtext_size"
        tools:ignore="RtlHardcoded"
        tools:text="234 videos" />

    <androidx.cardview.widget.CardView
        android:id="@+id/playlist_stats_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/playlist_stream_count"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/playlist_watched_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/playlist_detail_subtext_size"
                    tools:text="2 of 5 watched" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/playlist_time_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:visibility="gone"
                    tools:text="4:00:04 remaining" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/playlist_watched_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_watched_horizontal" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/playlist_completed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/playlist_completed_text"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/playlist_continue_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/playlist_continue_watching"
                android:textColor="?attr/colorAccent"
                android:textSize="16sp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:strokeColor="?attr/colorAccent" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/playlist_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/playlist_stats_card"
        layout="@layout/playlist_control" />

</RelativeLayout>
